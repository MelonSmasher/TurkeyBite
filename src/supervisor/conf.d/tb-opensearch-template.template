[program:turkey-bite-opensearch-template]
numprocs=1
numprocs_start=01
command=/turkey-bite/setup-opensearch-template.sh
process_name=%(program_name)s_%(process_num)02d
priority=999
autostart=true
autorestart=false
startsecs=0
startretries=3
exitcodes=0,2
stopsignal=TERM
stopwaitsecs=10
directory=/turkey-bite
user=root
redirect_stderr=false
stdout_logfile=/dev/fd/1
stdout_logfile_maxbytes=0
stderr_logfile=/dev/fd/2
stderr_logfile_maxbytes=0
