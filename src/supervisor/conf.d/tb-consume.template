[program:turkey-bite-consume]
numprocs=${TURKEYBITE_WORKER_PROCS}
numprocs_start=01
command=python turkeybite consume --consumer ${TURKEYBITE_CONSUMER_PREFIX}-%(process_num)02d
process_name=%(program_name)s_%(process_num)02d
priority=999
autostart=true
autorestart=unexpected
startsecs=5
startretries=3
exitcodes=0,2
stopsignal=TERM
stopwaitsecs=30
directory=/turkey-bite
user=root
redirect_stderr=false
stdout_logfile=/var/log/turkey-bite/turkey-bite-consume-%(process_num)s.out
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=10
stderr_logfile=/var/log/turkey-bite/turkey-bite-consume-%(process_num)s.err
stderr_logfile_maxbytes=10MB
stderr_logfile_backups=10
