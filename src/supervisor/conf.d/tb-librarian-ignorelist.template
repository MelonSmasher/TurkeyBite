[program:turkey-bite-librarian-ignorelist]
numprocs=1
numprocs_start=01
command=/turkey-bite/ignorelist.sh
process_name=%(program_name)s_%(process_num)02d
priority=999
autostart=true
autorestart=unexpected
startsecs=5
startretries=3
exitcodes=0,2
stopsignal=TERM
stopwaitsecs=10
directory=/turkey-bite
user=root
redirect_stderr=false
stdout_logfile=/dev/fd/1
stdout_logfile_maxbytes=0
stderr_logfile=/dev/fd/2
stderr_logfile_maxbytes=0
stderr_logfile_backups=10