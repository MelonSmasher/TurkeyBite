# Timezone for containers
TZ=UTC
#TZ=America/New_York

# Bind9
BIND9_IP=172.172.0.100

# Valkey
# Logging level for Valkey (options: debug, verbose, notice, warning, error, critical, alert, emergency)
VALKEY_LOGLEVEL=warning
# Interval in seconds to save the database (only if the key threshold is met)
VALKEY_SAVE_INTERVAL_SECONDS=60
# Number of changed keys required for a save operation (only if the interval is met)
VALKEY_SAVE_KEYS=1
# Hostname for Valkey
VALKEY_HOST=valkey
# Port to listen on for TLS connections
VALKEY_PORT=6379

# OpenSearch
OPENSEARCH_HOST=opensearch
OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"
# The OpenSearch admin password. setup.sh generates one. OpenSearch wants at
# least 8 characters with upper and lower case, a digit and a symbol; use only
# the symbols - _ . + = , % @ : ^ ! so .env and the healthcheck keep it intact.
# OpenSearch reads this only when its data volume is new, and the opensearch
# healthcheck logs in with it, so to change the password later follow
# "Changing the OpenSearch admin password" in the README.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=
# The librarian logs in with these. The password must match the one above,
# and there is no fallback.
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=
OPENSEARCH_CLUSTER_NAME=turkeybite
OPENSEARCH_DISCOVERY_TYPE=single-node
bootstrap.memory_lock=true
node.name=${OPENSEARCH_HOST}
discovery.type=single-node

# OpenSearch hosts for dashboards
OPENSEARCH_HOSTS='["https://opensearch:9200"]'
# The CA the librarian verifies OpenSearch's certificate against, as a path
# inside the librarian container. Unset, it connects without verifying and
# says so. See "Verifying OpenSearch's certificate" in the README.
#OPENSEARCH_CA_CERT=/turkey-bite/opensearch-root-ca.pem


# TurkeyBite
# The workers and the librarian refuse Changeit12345!, the OpenSearch admin
# password TurkeyBite used to ship with, which anyone can look up. On a
# disposable test install only, yes lets them use it anyway, with a warning.
#TURKEYBITE_ALLOW_DEFAULT_PASSWORD=yes
# Number of worker processes to run in the worker container
TURKEYBITE_WORKER_PROCS=2
# rq.SimpleWorker runs jobs in-process so connections and the domain index mmap
# are reused across jobs. rq.Worker forks a child per job, which discards them.
# Left at rq.Worker so an upgrade changes nothing on its own. Switch to
# rq.SimpleWorker to get connection and index reuse across jobs.
TURKEYBITE_WORKER_CLASS=rq.Worker
# Ingestion path. `rq` is the original: Packetbeat publishes to a pub/sub
# channel, the core subscribes and enqueues, workers dequeue. Pub/sub has no
# persistence, so a restart loses whatever was in flight.
# `consume` reads a durable Redis list instead, acknowledging only after the
# documents are indexed. Requires Packetbeat's output set to data_type: list.
TURKEYBITE_PIPELINE=rq
# How often a worker checks for a newly published domain index
TURKEYBITE_INDEX_SYNC_INTERVAL_SEC=300
# Interval in minutes to update the hosts file default is 720 (12 hours)
TURKEYBITE_HOSTS_INTERVAL_MIN=720
# Interval in minutes to update the ignorelist default is 5 (5 minutes)
TURKEYBITE_IGNORELIST_INTERVAL_MIN=5
# Days OpenSearch keeps each daily TurkeyBite index before deleting it. Every
# index holds per-user browsing data. 0 keeps them forever. Unset, the
# librarian creates, changes and removes nothing, and says so at every start.
# A longer period is applied when the librarian starts; a shorter one waits
# for you to confirm it, and indices that existed before the policy are kept
# until you attach it to them. See "Data retention" in the README.
TURKEYBITE_RETENTION_DAYS=90
