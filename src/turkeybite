#! /usr/bin/env python3

import click
from libtb.util import read_config, pull_host_lists, process_ignorelist, build_domain_index, sync_domain_index, pull_psl
from libtb.inlet import Inlet
from libtb.sieve import Filters
from libtb.processor import Processor


@click.group()
def cli():
    pass


@cli.command('run')
def run():
    # Read in the configuration
    config = read_config()
    # Instantiate a filter
    filters = Filters(config['sieve'])
    # Instantiate a processor
    processor = Processor(config['processor'], config['redis'])
    # Instantiate a inlet
    inlet = Inlet(config['redis'], filters, processor)
    # Open the flood gates
    inlet.open()


@cli.command('consume')
@click.option('--consumer', default=None, help='Stable name for this consumer, used to recover its own in-flight work.')
@click.option('--batch-size', default=None, type=int, help='Maximum events claimed per batch.')
@click.option('--quiet', is_flag=True, default=False, help='Suppress the per-event Queued/Dropped log lines.')
def consume(consumer, batch_size, quiet):
    """Drain the durable queue: sieve, enrich, index, then acknowledge."""
    import os
    import socket
    from redis import Redis
    from libtb.queue import ListQueue
    from libtb.consumer import Consumer

    config = read_config()
    queue_conf = config['redis']
    name = consumer or os.environ.get('TURKEYBITE_CONSUMER_NAME') \
        or f'{socket.gethostname()}-{os.getpid()}'

    bulk = (config['processor']['elastic'].get('bulk') or {})
    if config['processor']['elastic'].get('enable') and not bulk.get('enable'):
        print('Note: processor.elastic.bulk.enable is off. This path acknowledges '
              'after the flush, so batching is safe here and worth turning on.')

    redis = Redis(
        host=queue_conf['host'],
        port=queue_conf['port'],
        db=queue_conf['db'],
        password=queue_conf['password']
    )
    queue = ListQueue(redis, queue_conf['channel'], name)
    filters = Filters(config['sieve'])
    processor = Processor(config['processor'], config['redis'])
    worker = Consumer(
        queue, filters, processor,
        batch_size=batch_size or int(bulk.get('size') or 500),
        name=name,
        log_events=not quiet
    )
    worker.install_signal_handlers()
    print(f'Consuming {queue_conf["channel"]} as {name}')
    worker.run()


@cli.command('queue-recover')
@click.option('--prefix', default=None,
              help='Only sweep consumer names starting with this. Use the host prefix so one host does not reclaim another host\'s in-flight work.')
@click.option('--all', 'sweep_all', is_flag=True, default=False,
              help='Sweep every processing list regardless of prefix. Only safe when no consumer is running anywhere.')
def queue_recover(prefix, sweep_all):
    """Requeue work stranded in processing lists whose consumer no longer exists."""
    import os
    from redis import Redis
    from libtb.queue import recover_orphans

    if not prefix and not sweep_all:
        prefix = os.environ.get('TURKEYBITE_CONSUMER_PREFIX')
        if not prefix:
            print('Refusing to sweep without --prefix or --all: an unscoped sweep '
                  'can reclaim another host\'s in-flight work.')
            raise SystemExit(2)

    config = read_config()
    queue_conf = config['redis']
    redis = Redis(
        host=queue_conf['host'],
        port=queue_conf['port'],
        db=queue_conf['db'],
        password=queue_conf['password']
    )
    swept, requeued = recover_orphans(
        redis, queue_conf['channel'], match=None if sweep_all else prefix)
    scope = 'all consumers' if sweep_all else f'consumers matching {prefix}'
    print(f'Swept {swept} processing lists for {scope}, requeued {requeued} events')


@cli.command('hosts')
def hosts():
    pull_host_lists()


@cli.command('ignorelist')
def ignorelist():
    process_ignorelist()


@cli.command('psl')
def psl():
    """Refresh the cached Public Suffix List used for registrable domains."""
    pull_psl()


@cli.command('index')
def index():
    """Rebuild the memory-mapped domain index from the list files on disk."""
    build_domain_index()


@cli.command('index-sync')
def index_sync():
    """Download the published domain index if the local copy is out of date."""
    sync_domain_index()


@cli.command('audit')
@click.argument('reference', type=click.Path(exists=True, dir_okay=False))
@click.option('--top', default=10000, show_default=True,
              help='How many reference domains to check, from the top.')
@click.option('--examples', default=5, show_default=True,
              help='Example domains to print per category.')
@click.option('--category', 'categories', multiple=True,
              help='Only report these categories. Repeatable.')
@click.option('--index', 'index_path', default=None,
              help='Index file to audit. Defaults to the configured path.')
@click.option('--min-publishers', default=None,
              help='Override processor.evidence.min_publishers: a number, or '
                   'taxonomy branches with numbers such as default=2,threat=1.')
@click.option('--disable', 'disabled', multiple=True,
              help='Taxonomy branch or path to switch off, as '
                   'processor.evidence.disabled_categories. Repeatable. Defaults to '
                   'the configured list whenever the configuration is read.')
def audit(reference, top, examples, categories, index_path, min_publishers, disabled):
    """Report the categories the index asserts on known-good domains.

    REFERENCE is a Tranco 'rank,domain' CSV or one domain per line. Fetch the
    current Tranco list with:

    \b
        curl -L -o top-1m.csv.zip https://tranco-list.eu/top-1m.csv.zip
        unzip -o top-1m.csv.zip -d lists
    """
    from libtb.audit import audit as run_audit, format_report, parse_bar, read_reference
    from libtb.evidence import DEFAULT_MIN_PUBLISHERS, disabled_paths, thresholds
    from libtb.index import DomainIndex
    from libtb.util import index_config

    disabled = list(disabled) or None
    if min_publishers is not None:
        min_publishers = parse_bar(min_publishers)
    if index_path is None or min_publishers is None:
        config = read_config()
        index_path = index_path or index_config(config)['path']
        evidence = (config.get('processor') or {}).get('evidence') or {}
        if min_publishers is None:
            min_publishers = evidence.get('min_publishers', DEFAULT_MIN_PUBLISHERS)
        if disabled is None:
            disabled = evidence.get('disabled_categories')
    try:
        min_publishers = thresholds(min_publishers)
    except ValueError as e:
        raise click.BadParameter(str(e), param_hint='--min-publishers')
    try:
        disabled = disabled_paths(disabled)
    except ValueError as e:
        raise click.BadParameter(str(e), param_hint='--disable')

    domains = read_reference(reference, top)
    index = DomainIndex(index_path)
    try:
        report = run_audit(index, domains, min_publishers, disabled=disabled)
    finally:
        index.close()
    for line in format_report(report, len(domains), examples, set(categories)):
        print(line)

if __name__ == '__main__':
    cli()
