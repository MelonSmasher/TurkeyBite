#! /usr/bin/env python3

import time

import click
from libtb.util import read_config, pull_host_lists, process_ignorelist, build_domain_index, sync_domain_index, pull_psl
from libtb.inlet import Inlet
from libtb.sieve import Filters
from libtb.processor import Processor


@click.group()
def cli():
    pass


@cli.command('run')
def run():
    # Read in the configuration
    config = read_config()
    # Instantiate a filter
    filters = Filters(config['sieve'])
    # Instantiate a processor
    processor = Processor(config['processor'], config['redis'])
    # Instantiate a inlet
    inlet = Inlet(config['redis'], filters, processor)
    # Open the flood gates
    inlet.open()


@cli.command('check')
def check():
    """Check config.yaml as a worker reads it, before anything starts.

    Loads it and validates everything a worker needs: the sieve, the evidence,
    resolver and privacy settings, and each OpenSearch host, including that a
    ca_certs file is there and that the password is not the shipped default.
    The core container runs this before it starts anything, as does a worker
    container on the consume pipeline, and each exits if it fails rather than
    showing a mistake only as events failing to ship. Under the rq pipeline a
    worker runs the processor each job carries, which the core built from its
    own config.yaml, so the core's check is the one that covers it.
    """
    try:
        config = read_config()
        if not isinstance(config, dict):
            raise ValueError('config.yaml could not be read as YAML')
        Filters(config['sieve'])
        Processor(config['processor'], config['redis'])
    except (OSError, KeyError, TypeError, ValueError) as e:
        detail = f'missing setting {e}' if isinstance(e, KeyError) else str(e)
        click.echo(f'CONFIGURATION ERROR: {detail}', err=True)
        raise SystemExit(1)
    click.echo('config.yaml checked: the settings a worker reads are valid.')


@cli.command('consume')
@click.option('--consumer', default=None, help='Stable name for this consumer, used to recover its own in-flight work.')
@click.option('--batch-size', default=None, type=int, help='Maximum events claimed per batch.')
@click.option('--quiet', is_flag=True, default=False, help='Suppress the per-event Queued/Dropped log lines.')
def consume(consumer, batch_size, quiet):
    """Drain the durable queue: sieve, enrich, index, then acknowledge."""
    import os
    import socket
    from redis import Redis
    from libtb.queue import ListQueue
    from libtb.consumer import Consumer

    config = read_config()
    queue_conf = config['redis']
    name = consumer or os.environ.get('TURKEYBITE_CONSUMER_NAME') \
        or f'{socket.gethostname()}-{os.getpid()}'

    bulk = (config['processor']['elastic'].get('bulk') or {})
    if config['processor']['elastic'].get('enable') and not bulk.get('enable'):
        print('Note: processor.elastic.bulk.enable is off. This path acknowledges '
              'after the flush, so batching is safe here and worth turning on.')

    redis = Redis(
        host=queue_conf['host'],
        port=queue_conf['port'],
        db=queue_conf['db'],
        password=queue_conf['password']
    )
    queue = ListQueue(redis, queue_conf['channel'], name)
    # One process per name: two would share a processing list, and a requeue
    # by one could take the other's batch
    # A consumer that died without letting its name go, as a container that
    # was killed, holds it for OWNER_TTL seconds more: wait that out
    waited, patience = 0, ListQueue.OWNER_TTL + 10
    while not queue.reserve():
        if waited >= patience:
            click.echo(f'Another consumer is already running as {name}. Give this one a '
                       f'different --consumer, or stop that one first.', err=True)
            raise SystemExit(1)
        if not waited:
            click.echo(f'Waiting up to {patience} seconds for the name {name}, which another '
                       f'consumer holds or a stopped one held', err=True)
        time.sleep(5)
        waited += 5
    # Released however this ends, setup failing included, so a restart need
    # not wait out the reservation
    try:
        filters = Filters(config['sieve'])
        processor = Processor(config['processor'], config['redis'])
        worker = Consumer(
            queue, filters, processor,
            batch_size=batch_size or int(bulk.get('size') or 500),
            name=name,
            log_events=not quiet
        )
        worker.install_signal_handlers()
        print(f'Consuming {queue_conf["channel"]} as {name}')
        worker.run()
    finally:
        queue.release()
    if worker.name_lost:
        # Not a clean stop, so supervisor starts it again, to wait for the name
        raise SystemExit(1)


@cli.command('queue-recover')
@click.option('--prefix', default=None,
              help='Sweep the consumers the start scripts name <prefix>-NN, as '
                   'TURKEYBITE_CONSUMER_PREFIX, which is the default, holds it.')
@click.option('--consumer', 'consumers', multiple=True,
              help='Sweep exactly this consumer, such as one started by hand with '
                   '--consumer. Repeatable.')
@click.option('--all', 'sweep_all', is_flag=True, default=False,
              help='Sweep every processing list. Only safe when no consumer is running anywhere.')
def queue_recover(prefix, consumers, sweep_all):
    """Requeue work stranded in processing lists whose consumer no longer exists.

    Every consume worker runs this at start for its own prefix, before its
    consumers start. A consumer named by hand, such as `consume --consumer
    worker1`, is not swept by that: recover it with --consumer worker1 once it
    is stopped for good, or with --all.
    """
    import os
    from redis import Redis
    from libtb.queue import recover_orphans

    if sum(map(bool, (prefix, consumers, sweep_all))) > 1:
        raise click.UsageError('give one of --prefix, --consumer and --all')
    if not (prefix or consumers or sweep_all):
        prefix = os.environ.get('TURKEYBITE_CONSUMER_PREFIX')
        if not prefix:
            print('Refusing to sweep without --prefix, --consumer or --all: an unscoped '
                  'sweep can reclaim another host\'s in-flight work.')
            raise SystemExit(2)

    config = read_config()
    queue_conf = config['redis']
    redis = Redis(
        host=queue_conf['host'],
        port=queue_conf['port'],
        db=queue_conf['db'],
        password=queue_conf['password']
    )
    if consumers:
        swept, requeued = recover_orphans(redis, queue_conf['channel'], consumers=consumers)
        scope = 'consumer ' + ', '.join(consumers)
    elif sweep_all:
        swept, requeued = recover_orphans(redis, queue_conf['channel'])
        scope = 'all consumers'
    else:
        swept, requeued = recover_orphans(redis, queue_conf['channel'], prefix=prefix)
        scope = f'consumers named {prefix}-NN'
    print(f'Swept {swept} processing lists for {scope}, requeued {requeued} events')


