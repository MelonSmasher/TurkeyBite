# TurkeyBite Console settings. Copy to console.env, fill in, and keep it out of
# version control: it holds the secret key and the OpenSearch password.

# -- the console ------------------------------------------------------------
# Encrypts the secrets the database holds (webhook signing secrets, the LDAP
# bind password) and keys every HMAC. 32 characters at least; make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TBCONSOLE_SECRET_KEY=
# After changing the key, list the old one here until the secrets encrypted
# under it have been saved again, then remove it
TBCONSOLE_SECRET_KEY_PREVIOUS=
# Where people reach the console; links in alerts point here
TBCONSOLE_PUBLIC_URL=https://console.example.org
# The console's own database. docker-compose.yml sets these for you from
# POSTGRES_PASSWORD; without compose, give the URL and the password apart.
# TBCONSOLE_DATABASE_URL=postgresql+asyncpg://tbconsole@db.example.org:5432/tbconsole
# TBCONSOLE_DATABASE_PASSWORD=
POSTGRES_PASSWORD=
# Sessions: idle for 12 hours, or 7 days old, and they end
TBCONSOLE_SESSION_IDLE_MINUTES=720
TBCONSOLE_SESSION_MAX_HOURS=168
# Wrong passwords before a local account locks, and for how long
TBCONSOLE_LOGIN_MAX_FAILURES=5
TBCONSOLE_LOGIN_LOCKOUT_MINUTES=15
# The first admin, created at start only while the database has no users.
# Remove these once you have signed in and changed the password.
TBCONSOLE_BOOTSTRAP_ADMIN_USERNAME=admin
TBCONSOLE_BOOTSTRAP_ADMIN_PASSWORD=
# Behind a reverse proxy, the addresses or networks whose X-Forwarded-For is
# believed, so the audit log and the sign-in limits see the person's address
# rather than the proxy's. With docker-compose.yml and a proxy on the host,
# requests arrive from Docker's bridge, so trust that network.
TBCONSOLE_FORWARDED_ALLOW_IPS=172.16.0.0/12
# Only for plain-http testing; a session cookie sent in clear can be stolen
TBCONSOLE_COOKIE_SECURE=true
# Record every search in the audit log, not only those that name someone
TBCONSOLE_AUDIT_ALL_SEARCHES=false
# How long the console keeps closed findings and its audit log; 0 is for ever
TBCONSOLE_FINDING_RETENTION_DAYS=365
TBCONSOLE_AUDIT_RETENTION_DAYS=365
# Sent or abandoned webhook deliveries
TBCONSOLE_DELIVERY_RETENTION_DAYS=30
# How often directory accounts are checked against the directory
TBCONSOLE_LDAP_RECHECK_MINUTES=60
# Rules look at events up to this many seconds ago, so events still on their
# way into OpenSearch are counted
TBCONSOLE_RULE_INGEST_DELAY_SEC=60
# Run the rule scheduler, webhook dispatcher and housekeeping here. Turn off
# on extra API-only replicas.
TBCONSOLE_RUN_WORKERS=true

# -- OpenSearch or Elasticsearch, read only ----------------------------------------
# Comma-separated; each is tried in turn
TBCONSOLE_OPENSEARCH_URLS=https://opensearch.example.org:9200
# An account that can only read the TurkeyBite indices: see console/README.md
TBCONSOLE_OPENSEARCH_USERNAME=tbconsole_reader
TBCONSOLE_OPENSEARCH_PASSWORD=
TBCONSOLE_OPENSEARCH_VERIFY_CERTS=true
# The CA that signed the cluster's certificate, if a public CA did not: put it
# in ./certs, which docker-compose.yml mounts at /certs, and uncomment
# TBCONSOLE_OPENSEARCH_CA_CERTS=/certs/root-ca.pem
TBCONSOLE_OPENSEARCH_INDEX=tb-index-*
TBCONSOLE_OPENSEARCH_TIMEOUT_SEC=30

# -- webhooks ------------------------------------------------------------------------
# Allow webhook receivers on private addresses, such as a chat server on the LAN.
# Cloud metadata addresses are refused whatever this says.
TBCONSOLE_WEBHOOK_ALLOW_PRIVATE=false
TBCONSOLE_WEBHOOK_TIMEOUT_SEC=10
